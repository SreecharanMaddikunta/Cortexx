generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String?   @unique // Optional for farmers, required for admins
  phone     String?   @unique // Required for farmers
  password  String    // Mock OTP hash for farmers, real hash for admins
  role      String    @default("FARMER")

  createdAt DateTime  @default(now())
  
  crops     Crop[]    // A farmer can have multiple crops
  reports   Report[]
  messages  Message[]
}

model Crop {
  id            Int       @id @default(autoincrement())
  farmerId      Int
  name          String    // e.g., "Tomato Field A"
  type          String    // e.g., "Tomato"
  sowingDate    DateTime
  area          Float     // in acres
  expectedYield Float?    // in tons or quintals
  stage         String?   // e.g., "Vegetative", "Flowering", "Fruiting"
  createdAt     DateTime  @default(now())

  farmer        User      @relation(fields: [farmerId], references: [id])
  reports       Report[]
  tasks         Task[]
}

model Task {
  id          Int       @id @default(autoincrement())
  farmerId    Int
  cropId      Int?
  titleKey    String    // localization key or title
  descKey     String    // localization key or description
  type        String    // 'urgent' | 'routine' | 'water' | 'fertilizer'
  icon        String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  crop        Crop?     @relation(fields: [cropId], references: [id])
}

model Report {
  id                    Int      @id @default(autoincrement())
  farmerId              Int
  cropId                Int?     // Link report to a specific crop
  disease               String
  confidence            Float
  imageUrl              String?
  recommendedFertilizer String?
  actionSteps           String?  // Stored as JSON string (legacy)
  futureInsights        String?
  detailedReport        String?  // New field for the rich agronomist JSON
  location              String?  // lat,lng
  createdAt             DateTime @default(now())

  farmer                User     @relation(fields: [farmerId], references: [id])
  crop                  Crop?    @relation(fields: [cropId], references: [id])
}

model Alert {
  id          Int      @id @default(autoincrement())
  title       String
  message     String
  region      String   // Could be a district name or a polygon
  severity    String   // HIGH, MEDIUM, LOW
  createdAt   DateTime @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  farmerId  Int
  farmer    User     @relation(fields: [farmerId], references: [id])
  content   String
  isFromBot Boolean  @default(false)
  createdAt DateTime @default(now())
}

model OtpRecord {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
